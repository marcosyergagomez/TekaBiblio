echo "✅ Husky monorepo hook ejecutándose"
# Si hay cambios en apps/api → lint backend
if git diff --cached --name-only | grep -q '^apps/api/'; then
  echo "🔍 Linting API..."
  cd apps/api || exit 1
  pnpm lint || exit 1
  cd ../..
fi

# Si hay cambios en apps/web → lint frontend
if git diff --cached --name-only | grep -q '^apps/web/'; then
  echo "🔍 Linting Web..."
  cd apps/web || exit 1
  pnpm lint || exit 1
  cd ../..
fi