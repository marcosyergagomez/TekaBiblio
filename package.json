{
  "name": "tekabiblio",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm -C apps/api dev",
    "dev:web": "pnpm -C apps/web dev",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "start:prod": "pnpm -C apps/api start:prod",
    "start:prod:both": "pnpm -C apps/api start:prod & pnpm -C apps/web preview",
    "lint": "pnpm -r --filter \"./apps/*\" lint",
    "lint:fix": "pnpm -r --filter \"./apps/*\" lint:fix",
    "format": "pnpm -r --filter \"./apps/*\" format",
    "format:check": "pnpm -r --filter \"./apps/*\" format:check",
    "typecheck": "pnpm -r --filter \"./apps/*\" typecheck",
    "test": "pnpm -r --filter \"./apps/*\" test",
    "test:cov": "pnpm -r --filter \"./apps/*\" test:cov",
    "test:e2e": "pnpm -C apps/api test:e2e",
    "clean": "rimraf node_modules pnpm-lock.yaml && pnpm -r --filter \"./apps/*\" run clean",
    "ci": "pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/eslint-plugin-jsx-a11y": "6.10.0",
    "@typescript-eslint/eslint-plugin": "8.45.0",
    "@typescript-eslint/parser": "8.45.0",
    "eslint": "9.36.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "husky": "9.1.7",
    "prettier": "3.6.2",
    "rimraf": "^6.0.0"
  },
  "dependencies": {
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "^16.0.0"
  }
}
