{
  "name": "tekabiblio",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "corepack pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:api": "corepack pnpm -C apps/api dev",
    "dev:web": "corepack pnpm -C apps/web dev",
    "build": "corepack pnpm -r --filter \"./apps/*\" build",
    "start:prod": "corepack pnpm -C apps/api start:prod",
    "start:prod:both": "corepack pnpm -C apps/api start:prod & corepack pnpm -C apps/web preview",
    "lint": "corepack pnpm -r --filter \"./apps/*\" lint",
    "lint:md": "markdownlint-cli2 \"README.md\" \"docs/**/*.md\" \"apps/**/*.md\"",
    "lint:fix": "corepack pnpm -r --filter \"./apps/*\" lint:fix",
    "format": "corepack pnpm -r --filter \"./apps/*\" format",
    "format:check": "corepack pnpm -r --filter \"./apps/*\" format:check",
    "typecheck": "corepack pnpm -r --filter \"./apps/*\" typecheck",
    "test": "corepack pnpm -r --filter \"./apps/*\" test",
    "test:cov": "corepack pnpm -r --filter \"./apps/*\" test:cov",
    "test:e2e": "corepack pnpm -C apps/api test:e2e",
    "test:e2e:web": "corepack pnpm -C apps/web test:e2e",
    "security:csp:check": "node scripts/security/check-csp.mjs",
    "security:audit": "corepack pnpm audit --prod --audit-level high",
    "quality:gate": "corepack pnpm lint && corepack pnpm lint:md && corepack pnpm typecheck && corepack pnpm test && corepack pnpm test:e2e && corepack pnpm test:e2e:web && corepack pnpm build",
    "clean": "rimraf node_modules pnpm-lock.yaml && corepack pnpm -r --filter \"./apps/*\" run clean",
    "ci": "corepack pnpm quality:gate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/eslint-plugin-jsx-a11y": "6.10.0",
    "@typescript-eslint/eslint-plugin": "8.45.0",
    "@typescript-eslint/parser": "8.45.0",
    "eslint": "9.36.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "globals": "^16.0.0",
    "husky": "9.1.7",
    "markdownlint-cli2": "0.22.0",
    "prettier": "3.6.2",
    "rimraf": "^6.0.0"
  },
  "pnpm": {
    "overrides": {
      "diff": "4.0.4"
    }
  }
}
